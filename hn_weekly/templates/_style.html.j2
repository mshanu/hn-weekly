<style>
:root {
  --bg: #f7f6f2; --surface: #ffffff; --text: #1d1c1a; --muted: #6b6860; --line: #e4e1d8;
  --accent: #d2561c;
  --v-enthusiastic: #2f7d4f; --v-skeptical: #b4432f; --v-divided: #8a5fbf; --v-informative: #3769a8;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161513; --surface: #1f1e1b; --text: #ecebe6; --muted: #9c998f; --line: #34322d;
    --accent: #f07a3e;
    --v-enthusiastic: #6cc48f; --v-skeptical: #ee8a76; --v-divided: #bb9be6; --v-informative: #86afe6;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif; }
.wrap { max-width: 1080px; margin: 0 auto; padding: 32px 16px 64px; }
a { color: inherit; }
.kicker { color: var(--accent); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; font-size: 12px; }
h1 { font-size: 28px; line-height: 1.15; margin: 6px 0 6px; letter-spacing: -.01em; }
.headline { margin: 0 0 8px; color: var(--muted); font-size: 16px; max-width: 70ch; }
.sec { margin-top: 32px; }
.sec h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted);
  margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
.sec h2 { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.sheat { display: flex; align-items: center; gap: 8px; flex: 0 1 220px; }
.sheat .bar { flex: 1; height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; min-width: 60px; }
.sheat .bar span { display: block; height: 100%; border-radius: 3px;
  background: linear-gradient(90deg, #f2b33d, var(--accent)); }
.hottest { color: var(--accent); font-weight: 700; }
.box .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.flames { font-size: 13px; white-space: nowrap; letter-spacing: -2px; line-height: 1.4; }
.flames.f1 { opacity: .55; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
.box { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px;
  display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.box:hover { border-color: var(--accent); }
.box h3 { font-size: 16px; line-height: 1.25; margin: 0; overflow-wrap: anywhere; }
.box h3 a { text-decoration: none; }
.box h3 a:hover { text-decoration: underline; }
.gist { margin: 0; }
.mood { align-self: flex-start; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 999px;
  border: 1px solid currentColor; }
.v-enthusiastic { color: var(--v-enthusiastic); } .v-skeptical { color: var(--v-skeptical); }
.v-divided { color: var(--v-divided); } .v-informative { color: var(--v-informative); }
.take { margin: 0; color: var(--muted); font-style: italic; }
.foot { margin-top: auto; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; font-size: 13px; }
.discuss { margin-left: auto; color: var(--accent); text-decoration: none; }
.discuss:hover { text-decoration: underline; }
.threads summary { cursor: pointer; color: var(--muted); list-style: none; }
.threads summary::-webkit-details-marker { display: none; }
.threads summary::before { content: "▸ "; }
.threads[open] summary::before { content: "▾ "; }
.threads[open] { flex-basis: 100%; order: 2; }
.threads ul { margin: 6px 0 0; padding-left: 16px; }
.threads li { margin: 3px 0; }
.threads li a { color: var(--accent); text-decoration: none; }
.threads li a:hover { text-decoration: underline; }
.more { margin-top: 36px; }
.more summary { cursor: pointer; color: var(--muted); }
.more ul { columns: 2 280px; padding-left: 18px; margin: 10px 0; }
.more li { margin: 3px 0; break-inside: avoid; }
.more .hn { color: var(--accent); font-size: 12px; margin-left: 4px; }
.week-row { display: block; text-decoration: none; background: var(--surface); border: 1px solid var(--line);
  border-radius: 10px; padding: 14px 16px; margin: 12px 0; }
.week-row:hover { border-color: var(--accent); }
.week-row p { margin: 6px 0 0; color: var(--muted); }
.meta { color: var(--muted); font-size: 13px; }
footer { margin-top: 48px; color: var(--muted); font-size: 12px; }

/* ---------- Newscast ---------- */
:root { --ink: #121212; --ink-text: #f4f2ec; --live: #e5322d; --glow: rgba(210, 86, 28, .18); }
@media (prefers-color-scheme: dark) { :root { --ink: #0b0b0a; --glow: rgba(240, 122, 62, .22); } }
.masthead { background: var(--ink); color: var(--ink-text); border-bottom: 3px solid var(--accent); }
.mast-inner { max-width: 1080px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 8px; font-weight: 800; letter-spacing: .12em; font-size: 15px; text-decoration: none; }
.logo { display: inline-grid; place-items: center; width: 22px; height: 22px; background: var(--accent); color: #fff;
  letter-spacing: 0; border-radius: 3px; }
.logo svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
.onair { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; letter-spacing: .1em;
  padding: 3px 8px; border-radius: 3px; background: #3a3a38; color: #cfccc4; }
.onair .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.playing .onair { background: var(--live); color: #fff; }
.playing .onair .dot { animation: blink 1.2s infinite; }
@keyframes blink { 50% { opacity: .25; } }
.mast-date { margin-left: auto; font-size: 13px; color: #b9b6ad; }
.mast-archive { font-size: 13px; color: #b9b6ad; }
.wrap { padding-top: 24px; }
.lead h1 { font-size: clamp(22px, 3.4vw, 32px); line-height: 1.2; max-width: 32ch; margin: 8px 0 18px; }

.player { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 14px; margin: 0 0 8px;
  padding: 12px 14px; background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line); border-radius: 12px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, .06); }
.play { flex: none; width: 48px; height: 48px; border-radius: 50%; border: 0; background: var(--accent); color: #fff;
  display: grid; place-items: center; cursor: pointer; }
.play svg { width: 22px; height: 22px; fill: currentColor; }
.play svg[hidden] { display: none; }
.play:hover { filter: brightness(1.08); }
.pmain { flex: 1; min-width: 0; }
.now { display: flex; align-items: baseline; gap: 8px; min-width: 0; margin-bottom: 6px; }
.now-kind { flex: none; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
.now-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.track { position: relative; height: 8px; border-radius: 4px; background: var(--line); cursor: pointer; }
.fill { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: 4px; background: var(--accent); }
.tick { position: absolute; top: -2px; width: 2px; height: 12px; background: var(--muted); opacity: .5; border-radius: 1px; }
.ptime { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); margin-top: 4px;
  font-variant-numeric: tabular-nums; }
.speed { flex: none; font: 600 13px/1 inherit; font-family: inherit; padding: 8px 10px; border-radius: 8px;
  border: 1px solid var(--line); background: transparent; color: var(--text); cursor: pointer; min-width: 52px; }

.box { position: relative; transition: border-color .2s, box-shadow .2s, transform .2s; }
.box.seekable { cursor: pointer; }
.at { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
.box.seekable:hover .at { color: var(--accent); }
.live-badge { position: absolute; top: -10px; left: 12px; display: none; font-size: 11px; font-weight: 800;
  letter-spacing: .06em; text-transform: uppercase; padding: 2px 8px; border-radius: 3px; background: var(--live); color: #fff; }
.box.on-air { border-color: var(--accent); box-shadow: 0 0 0 3px var(--glow); }
.box.on-air .live-badge { display: inline-block; }
@media (prefers-reduced-motion: no-preference) {
  .playing .box.on-air { animation: onair 2.4s ease-in-out infinite; }
  @keyframes onair { 50% { box-shadow: 0 0 0 6px var(--glow); } }
}

.transcript { margin-top: 36px; }
.transcript summary { cursor: pointer; color: var(--muted); }
.transcript ol { list-style: none; padding: 0; margin: 12px 0 0; max-width: 72ch; }
.transcript li { padding: 8px 10px; border-radius: 8px; margin: 2px 0; }
.transcript li.cur { background: var(--surface); outline: 1px solid var(--line); }
.ts { font: 12px/1 inherit; font-family: inherit; font-variant-numeric: tabular-nums; color: var(--accent);
  background: none; border: 0; padding: 0 6px 0 0; cursor: pointer; }
.tk { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-right: 4px; }

body.has-ticker { padding-bottom: 40px; }
.ticker { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; align-items: stretch; height: 34px;
  background: var(--ink); color: var(--ink-text); font-size: 13px; border-top: 2px solid var(--accent); }
.ticker-label { flex: none; display: flex; align-items: center; padding: 0 12px; background: var(--accent); color: #fff;
  font-weight: 800; font-size: 11px; letter-spacing: .1em; }
.ticker-viewport { flex: 1; overflow: hidden; display: flex; align-items: center; }
.ticker-track { display: flex; width: max-content; animation: ticker var(--dur) linear infinite; }
.ticker:hover .ticker-track { animation-play-state: paused; }
.ticker-run { display: flex; align-items: center; white-space: nowrap; }
.ticker a { text-decoration: none; padding: 0 4px; }
.ticker a:hover { color: var(--accent); }
.ticker .sep { color: var(--accent); padding: 0 10px; font-size: 9px; }
@keyframes ticker { to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) {
  .ticker-track { animation: none; }
  .ticker-viewport { overflow-x: auto; }
}
@media (max-width: 560px) {
  .mast-date { margin-left: 0; width: 100%; order: 3; }
  .player { gap: 10px; padding: 10px; }
  .play { width: 42px; height: 42px; }
  .ticker-label { padding: 0 8px; font-size: 10px; }
}

/* ---------- Presentation (stage) ---------- */
.watch { display: inline-flex; align-items: center; gap: 10px; margin: -6px 0 18px; padding: 10px 18px 10px 14px;
  border: 0; border-radius: 999px; background: var(--ink); color: var(--ink-text); font: 600 15px/1 inherit;
  font-family: inherit; cursor: pointer; box-shadow: 0 4px 14px rgba(0, 0, 0, .12); }
.watch svg { width: 18px; height: 18px; fill: var(--accent); }
.watch span { font-weight: 500; color: #b9b6ad; font-variant-numeric: tabular-nums; }
.watch:hover { outline: 2px solid var(--accent); }
@media (prefers-color-scheme: dark) { .watch { background: var(--accent); color: #fff; } .watch svg { fill: #fff; } .watch span { color: #ffe3d4; } }
body.staged { overflow: hidden; }
.stage { position: fixed; inset: 0; z-index: 100; display: grid; grid-template-rows: auto 1fr auto auto;
  color: #f4f2ec; background: radial-gradient(1200px 600px at 80% -10%, rgba(240, 122, 62, .22), transparent 60%),
  radial-gradient(900px 500px at -10% 110%, rgba(55, 105, 168, .25), transparent 60%), #0d0d0c;
  --accent: #f07a3e; --muted: #a8a59b; --line: #34322d;
  --v-enthusiastic: #6cc48f; --v-skeptical: #ee8a76; --v-divided: #bb9be6; --v-informative: #86afe6; }
.stage[hidden] { display: none; }
.st-bar { display: flex; align-items: center; gap: 14px; padding: 12px 20px; }
.st-bar .brand { color: #f4f2ec; }
.st-date { margin-left: auto; font-size: 13px; color: var(--muted); }
.st-btn { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid transparent;
  background: rgba(255, 255, 255, .07); color: #f4f2ec; cursor: pointer; font: 700 12px/1 inherit; font-family: inherit; }
.st-btn:hover { background: rgba(255, 255, 255, .14); }
.st-btn[hidden] { display: none; }
.st-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
#st-prev svg, #st-next svg { fill: currentColor; }
.st-cc[aria-pressed="true"] { background: #f4f2ec; color: #0d0d0c; }

.slides { position: relative; min-height: 0; cursor: pointer; }
.slide { position: absolute; inset: 0; display: flex; align-items: center; overflow-y: auto;
  opacity: 0; visibility: hidden; transform: translateY(18px); }
.slide.past { transform: translateY(-18px); }
.slide.cur { opacity: 1; visibility: visible; transform: none; }
@media (prefers-reduced-motion: no-preference) {
  .slide { transition: opacity .5s ease, transform .6s cubic-bezier(.2, .7, .2, 1), visibility 0s linear .6s; }
  .slide.cur { transition: opacity .5s ease .1s, transform .6s cubic-bezier(.2, .7, .2, 1) .1s, visibility 0s; }
  .slide.cur .s-inner > * { animation: rise .6s cubic-bezier(.2, .7, .2, 1) both; }
  .slide.cur .s-inner > :nth-child(2) { animation-delay: .12s; }
  .slide.cur .s-inner > :nth-child(3) { animation-delay: .24s; }
  .slide.cur .s-inner > :nth-child(4) { animation-delay: .9s; }
  .slide.cur .s-inner > :nth-child(5) { animation-delay: 1.1s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
}
.s-inner { width: 100%; max-width: 980px; margin: auto; padding: 24px clamp(20px, 5vw, 56px); cursor: auto; }
.s-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; color: var(--accent); font-weight: 800;
  font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
.s-sec { color: var(--muted); font-weight: 600; letter-spacing: .06em; }
.s-sec::before { content: "·"; margin-right: 12px; color: var(--muted); }
.s-kicker .flames { letter-spacing: -2px; }
.s-title { font-size: clamp(30px, 5.4vw, 64px); line-height: 1.05; letter-spacing: -.02em; margin: 14px 0 18px; max-width: 18ch; }
.s-gist { font-size: clamp(19px, 2.4vw, 28px); line-height: 1.35; margin: 0 0 28px; max-width: 34ch; color: #e6e3db; }
.s-hn { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 10px 14px; max-width: 760px;
  padding: 16px 20px; border-left: 4px solid var(--accent); background: rgba(255, 255, 255, .05); border-radius: 0 12px 12px 0; }
.s-hn-label { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.s-hn .mood { justify-self: start; font-size: 13px; }
.s-take { grid-column: 1 / -1; margin: 0; font-size: clamp(17px, 2vw, 22px); font-style: italic; color: #d9d6cd; }
.s-link { display: inline-block; margin-top: 22px; color: var(--accent); text-decoration: none; font-weight: 600; }
.s-link:hover { text-decoration: underline; }
.k-rapid .s-title, .k-launches .s-title { font-size: clamp(28px, 4.6vw, 54px); }
.s-date { font-size: clamp(16px, 2vw, 20px); color: var(--muted); margin-top: 10px; }
.s-head { font-size: clamp(26px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.015em; margin: 12px 0 0; max-width: 26ch; }
.s-coming span { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.s-coming ol { list-style: none; counter-reset: c; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
.s-coming li { counter-increment: c; padding: 10px 16px; border-radius: 10px; background: rgba(255, 255, 255, .07);
  font-size: clamp(15px, 1.7vw, 18px); font-weight: 600; }
.s-coming li::before { content: counter(c); color: var(--accent); margin-right: 10px; font-weight: 800; }
.s-quote { position: relative; margin: 22px 0 22px; padding-left: clamp(36px, 6vw, 72px); font-size: clamp(24px, 3.6vw, 42px);
  line-height: 1.25; font-weight: 600; letter-spacing: -.01em; max-width: 30ch; }
.s-quote::before { content: "“"; position: absolute; left: 0; top: -.18em; font-size: 2.6em; line-height: 1; color: var(--accent); font-family: Georgia, serif; }
.s-by { padding-left: clamp(36px, 6vw, 72px); color: var(--muted); font-size: clamp(15px, 1.7vw, 18px); }
.s-by b { color: #f4f2ec; }
.s-by a { color: var(--accent); text-decoration: none; }
.s-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.s-replay, .s-plain { font: 600 16px/1 inherit; font-family: inherit; padding: 12px 18px; border-radius: 999px; cursor: pointer; }
.s-replay { border: 0; background: var(--accent); color: #fff; }
.s-startrow { margin: 26px 0 30px; }
.playing .s-startrow { visibility: hidden; }
.s-plain { border: 1px solid rgba(255, 255, 255, .25); background: transparent; color: #f4f2ec; }

.st-low { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 0 20px 10px; }
.caption { max-width: min(900px, 100%); min-height: 1.4em; padding: 6px 14px; border-radius: 6px; text-align: center;
  background: rgba(0, 0, 0, .65); font-size: clamp(16px, 1.9vw, 21px); line-height: 1.4; }
.caption.empty, .no-cc .caption { visibility: hidden; }
.lower3 { align-self: stretch; display: flex; max-width: 980px; width: 100%; margin: 0 auto; font-weight: 700; overflow: hidden; border-radius: 4px; }
.l3-kind { flex: none; padding: 8px 14px; background: var(--live); color: #fff; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; display: flex; align-items: center; }
.l3-title { flex: 1; min-width: 0; padding: 8px 14px; background: #f4f2ec; color: #121212; font-size: 15px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.st-ctrl { display: flex; align-items: center; gap: 12px; padding: 10px 20px 16px; max-width: 1020px; width: 100%; margin: 0 auto; }
.st-ctrl .play { width: 52px; height: 52px; }
.chapters { flex: 1; display: flex; gap: 3px; min-width: 0; }
.ch { flex: 1 1 0; min-width: 4px; height: 26px; padding: 10px 0; border: 0; background: none; cursor: pointer; }
.ch i { display: block; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, .2); overflow: hidden; }
.ch:hover i { background: rgba(255, 255, 255, .35); }
.ch b { display: block; height: 100%; width: 0; background: var(--accent); }
.st-time { flex: none; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
@media (max-width: 560px) {
  .st-bar { padding: 10px 12px; gap: 10px; }
  .st-bar .onair { display: none; }
  .st-ctrl { flex-wrap: wrap; gap: 8px; padding: 6px 12px 14px; }
  .chapters { order: -1; flex-basis: 100%; }
  .st-time { margin-left: auto; }
  .s-hn { grid-template-columns: 1fr; }
  .st-low { padding: 0 12px 6px; }
}
@media (max-height: 560px) { .lower3 { display: none; } }
</style>
